# Production environment for Knit. Lives at /opt/knit/app-src/.env, owned by knit,
# mode 600. It's read by systemd (EnvironmentFile) and by the npm scripts
# (--env-file-if-exists=.env), so keep plain KEY=value lines: no quotes, and comments
# only on their own lines. Never commit real values. Generate secrets on the VPS.

# Written by BOOTSTRAP.md §3 with a password generated on the box.
DATABASE_URL=postgresql://knit:CHANGE_ME@127.0.0.1:5432/knit

# Invite and password-reset links are built from this. Must be the public HTTPS address.
BETTER_AUTH_URL=https://knit.marzipan-solutions.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# Browser push notifications. deploy.sh generates these once when all three are blank;
# to configure them by hand, generate the key pair together with:
#   npx web-push generate-vapid-keys
# The public key is intentionally visible to browsers; keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Study assistant (lib/llm.ts): every provider with a key joins the fallback chain,
# Gemini, then Groq, then OpenRouter. At least one is needed for the assistant to answer.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides (defaults are in lib/llm.ts)
# ASSISTANT_PROVIDERS=gemini,groq,openrouter
# GEMINI_MODELS=
# GROQ_MODEL=
# OPENROUTER_MODELS=
